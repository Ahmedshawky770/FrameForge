#!/bin/bash
# AppRun script for FrameForge AppImage
# Sets up the runtime environment for the bundled application

set -e

# Determine the directory where this AppRun script lives
APPDIR="$(dirname "$(readlink -f "$0")")"

# Export essential environment variables
export APPDIR
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
export PATH="${APPDIR}/usr/bin:${PATH}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-}"
export XDG_CONFIG_DIRS="${APPDIR}/usr/share:${XDG_CONFIG_DIRS:-}"
export GIO_EXTRA_MODULES="${APPDIR}/usr/lib/x86_64-linux-gnu/gio/modules:${GIO_EXTRA_MODULES:-}"
export GTK_EXE_PREFIX="${APPDIR}/usr"
export GTK_DATA_PREFIX="${APPDIR}/usr"
export GDK_PIXBUF_MODULE_FILE="${APPDIR}/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache"

# Set up VAAPI/NVENC device access (important for hardware acceleration)
# These need to be passed through from the host
export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-i965}"
export VDPAU_DRIVER="${VDPAU_DRIVER:-}"

# Run the main application
exec "${APPDIR}/usr/bin/frameforge" "$@"
