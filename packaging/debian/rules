#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

%:
	dh $@

override_dh_auto_build:
	cd $(CURDIR)/.. && cargo build --release --locked

override_dh_auto_install:
	dh_auto_install
	install -m 0755 -d debian/frameforge/usr/bin
	install -m 0755 -d debian/frameforge/usr/share/applications
	install -m 0755 -d debian/frameforge/usr/share/icons/hicolor/256x256/apps
	install -m 0755 target/release/frameforge-tauri-app debian/frameforge/usr/bin/frameforge
	install -m 0644 packaging/debian/frameforge.desktop debian/frameforge/usr/share/applications/frameforge.desktop
	install -m 0644 apps/tauri-app/icons/icon.png debian/frameforge/usr/share/icons/hicolor/256x256/apps/frameforge.png

override_dh_auto_clean:
	cd $(CURDIR)/.. && cargo clean
	dh_auto_clean

.PHONY: override_dh_auto_build override_dh_auto_install override_dh_auto_clean
