{
  "name": "@frameforge/media-player",
  "version": "0.1.0",
  "description": "FrameForge playback-only web component <media-player>. Tiered strategy: native <video> -> MSE remux -> WebCodecs + JS/WASM demuxer -> unsupported message.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "keywords": [
    "video",
    "player",
    "web-component",
    "media-player",
    "frameforge",
    "hls",
    "mpegts",
    "webcodecs"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/frameforge/frameforge.git"
  },
  "bugs": {
    "url": "https://github.com/frameforge/frameforge/issues"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^2.79.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.34.0",
    "typescript": "^5.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not KaiOS 2.5"
  ]
}
